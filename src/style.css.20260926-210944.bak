:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #171715;
  background: #f0eee8;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; overflow-x: hidden; background: #f0eee8; }
img { display: block; user-select: none; -webkit-user-drag: none; }

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .16;
  z-index: 50;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
}

.panel {
  min-height: 100svh;
  display: grid;
  align-items: center;
  padding: clamp(28px, 5vw, 82px);
}

.copy { max-width: 940px; }
.copy.narrow { max-width: 780px; }
.eyebrow {
  margin: 0 0 20px;
  font-size: 11px;
  letter-spacing: .2em;
  font-weight: 750;
}

h1, h2, p { margin-top: 0; }
h1 {
  margin-bottom: 26px;
  max-width: 900px;
  font-size: clamp(3rem, 7.8vw, 8.3rem);
  font-weight: 560;
  letter-spacing: -.065em;
  line-height: .88;
}
.outro h2 {
  margin-bottom: 25px;
  font-size: clamp(2.7rem, 6vw, 6.6rem);
  font-weight: 560;
  letter-spacing: -.06em;
  line-height: .92;
}
.lede {
  max-width: 650px;
  color: #55534e;
  font-size: clamp(1rem, 1.4vw, 1.25rem);
  line-height: 1.6;
}
.scroll-cue { margin-top: 54px; font-size: 12px; letter-spacing: .11em; }

.experience { position: relative; height: 390svh; border-block: 1px solid rgba(23,23,21,.16); }
.sticky-stage {
  position: sticky;
  top: 0;
  height: 100svh;
  overflow: hidden;
  background: #e8e5dd;
}

.scene-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(23,23,21,.055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(23,23,21,.055) 1px, transparent 1px);
  background-size: 9vw 9vw;
  mask-image: linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
}

.stage-copy {
  position: absolute;
  left: clamp(24px, 5vw, 74px);
  top: clamp(24px, 6vh, 62px);
  z-index: 8;
}
.stage-copy span { display: block; font-size: clamp(4rem, 10vw, 9rem); line-height: .82; letter-spacing: -.08em; font-weight: 550; }
.stage-copy p { margin: 16px 0 0; font-size: 10px; letter-spacing: .18em; font-weight: 800; }

.cat-scroll-rig {
  --cat-w: min(68vw, 490px);
  position: absolute;
  width: var(--cat-w);
  aspect-ratio: 288 / 335;
  left: 50%;
  top: 50%;
  translate: -50% -47%;
  transform-origin: 50% 60%;
  will-change: transform;
  z-index: 5;
}

.cat-idle-rig {
  position: absolute;
  inset: 0;
  transform-origin: 50% 72%;
  will-change: transform;
  opacity: 0;
  transition: opacity .35s ease;
}
.ready .cat-idle-rig { opacity: 1; }

.cat-layer { position: absolute; pointer-events: none; }

/* These coordinates recreate the supplied cropped layers inside a 288 × 335 rig. */
.tail-wrap {
  position: absolute;
  /* The thick upper-right end of tail.png is the root. Its pivot sits at
     the bottom-center of the cropped body layer, behind the body. */
  width: 41%;
  aspect-ratio: 118 / 122;
  left: 35.1%;
  top: 89.9%;
  z-index: 0;
  transform-origin: 80% 18%;
  translate: -80% -18%;
  will-change: transform;
}
.tail { width: 100%; inset: 0; }

.body {
  /* body.png is now 159px wide after only right-side empty space was
     removed. Preserve the old 288px-rig pixel scale instead of stretching
     the visible artwork back to the former 241px layer width. */
  width: 55.2083%;
  left: 7.5%;
  top: 4.5%;
  z-index: 2;
  transform-origin: 50% 72%;
}

.head {
  /* head.png is now 179px wide after the same right-side-only crop. */
  width: 62.1528%;
  left: 7%;
  top: 3.1%;
  z-index: 5;
  transform-origin: 50% 42%;
}

.feet-clip {
  position: absolute;
  width: 29.52%;
  height: 90.45%;
  top: 3.6%;
  z-index: 4;
  overflow: hidden;
  will-change: transform;
  transform-origin: 50% 94%;
}
.feet-left { left: 20.1%; }
.feet-right { left: 49.62%; }
.feet-source {
  width: 200%;
  max-width: none;
  top: 0;
}
.feet-left .feet-source { left: 0; }
.feet-right .feet-source { left: -100%; }

.face-rig {
  position: absolute;
  inset: 0;
  z-index: 8;
  perspective: 520px;
  transform-style: preserve-3d;
}
.earholes {
  width: 46.53%;
  left: 24.8%;
  top: 10.8%;
  will-change: transform;
}
.eye-window {
  position: absolute;
  width: 28%;
  height: 9%;
  left: 34.2%;
  top: 20.2%;
  overflow: hidden;
  z-index: 4;
}
.eyes {
  width: 69.44%;
  left: 15%;
  top: 10%;
  will-change: transform;
}
.brows {
  width: 25.7%;
  left: 35.5%;
  top: 17%;
  will-change: transform;
  transform-origin: 50% 50%;
  transform-style: preserve-3d;
  backface-visibility: visible;
  z-index: 5;
}
.whiskers {
  width: 65.28%;
  left: 15.3%;
  top: 29.2%;
  will-change: transform;
  z-index: 6;
}
.mouth {
  width: 17.02%;
  left: 39.4%;
  top: 27.8%;
  will-change: transform;
  transform-origin: 50% 50%;
  transform-style: preserve-3d;
  backface-visibility: visible;
  z-index: 7;
}

.progress-rail {
  position: absolute;
  right: clamp(18px, 3vw, 42px);
  top: 12vh;
  bottom: 12vh;
  width: 1px;
  background: rgba(23,23,21,.18);
}
.progress-fill {
  position: absolute;
  inset: 0;
  background: #171715;
  transform: scaleY(0);
  transform-origin: top;
}

.scroll-beat {
  position: absolute;
  width: min(320px, 34vw);
  z-index: 12;
  pointer-events: none;
}
.scroll-beat p { margin-bottom: 9px; font-size: 10px; letter-spacing: .16em; font-weight: 800; }
.scroll-beat h2 { margin-bottom: 10px; font-size: clamp(1.8rem, 4vw, 4rem); letter-spacing: -.055em; line-height: .9; font-weight: 560; }
.scroll-beat span { display: block; color: #65615b; font-size: 13px; line-height: 1.5; }
.beat-one { top: 62svh; left: 7vw; }
.beat-two { top: 168svh; right: 8vw; text-align: right; }
.beat-three { top: 286svh; left: 8vw; }

.restart { display: inline-block; margin-top: 25px; color: inherit; font-size: 12px; text-underline-offset: 5px; }

@media (max-width: 720px) {
  .panel { padding: 26px 20px; }
  .experience { height: 350svh; }
  .cat-scroll-rig {
    /* Keep the complete feet and tail arc inside narrow/short phone screens. */
    --cat-w: min(78vw, 360px, calc(76svh * 288 / 335));
    top: 52%;
  }
  .stage-copy { left: 20px; top: 24px; }
  .stage-copy span { font-size: 4.5rem; }
  .scroll-beat { width: 48vw; }
  .beat-one { left: 20px; top: 70svh; }
  .beat-two { right: 24px; top: 155svh; }
  .beat-three { left: 20px; top: 264svh; }
  .scene-grid { background-size: 18vw 18vw; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .cat-scroll-rig { transform: none !important; }
  .cat-idle-rig { opacity: 1; }
}
